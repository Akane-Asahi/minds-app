NODE_ENV=development
PORT=5001

# Optional: extra browser origins (comma-separated). In non-production, local dev origins (including
# http://localhost:3002) are always merged in. In production, this list is the only allowlist.
# CORS_ORIGINS=https://app.example.com

# JWT (required - set JWT_SECRET in deployment)
JWT_SECRET=
JWT_EXPIRES_IN=90d

# Enable participant/study login (find-or-create by participantId)
ALLOW_STUDY_LOGIN=true

# MongoDB (use MONGO_URI or MONGODB_URI)
# Verify: Atlas Network Access allows your AWS/deployment IP; credentials correct; database exists.
MONGO_URI=

# Primo API (library search - never expose in frontend)
PRIMO_API_KEY=
PRIMO_BASE_URL=https://api-na.hosted.exlibrisgroup.com/primo/v1/search
PRIMO_INSTITUTION=01CASLS_REGINA

# Document details API (external, no key required)
EXTERNAL_API_BASE=http://147.182.148.79/sils/api/search/item/full

# Auth flow debug logging (server console)
AUTH_DEBUG=false
